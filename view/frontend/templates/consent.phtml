    #slova-cookie .cc-modal__actions > * { flex: 1 1 auto; }

    /* ---------- Toggle switch ---------- */
    #slova-cookie .cc-toggle { position: relative; display: inline-block; width: 2.75rem; height: 1.5rem; flex: 0 0 auto; }
    #slova-cookie .cc-toggle input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
    #slova-cookie .cc-toggle__track { position: absolute; inset: 0; background: #cbd5e1; border-radius: 9999px; transition: background 0.2s; }
    #slova-cookie .cc-toggle__track::after {
        content: ""; position: absolute; top: 2px; left: 2px; width: 1.25rem; height: 1.25rem;
        background: #fff; border-radius: 9999px; box-shadow: 0 1px 2px rgb(0 0 0 / 0.2); transition: transform 0.2s;
    }
    #slova-cookie .cc-toggle input:checked + .cc-toggle__track { background: #006E8A; }
    #slova-cookie .cc-toggle input:checked + .cc-toggle__track::after { transform: translateX(1.25rem); }
    #slova-cookie .cc-toggle input:disabled { cursor: not-allowed; }
    #slova-cookie .cc-toggle input:disabled + .cc-toggle__track { background: #94a3b8; }
