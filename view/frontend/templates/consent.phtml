 * Copyright © Slova. Licensed under the MIT License, see LICENSE.
 *
 * The markup is the same for every visitor (safe in the full page cache); the Alpine
 * component in web/js/consent.js reads the consent cookie and decides what to show.
 * Styles are in web/css/consent.css: no Tailwind rebuild is needed.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Slova\CookieConsent\ViewModel\Config;

/** @var Template $block */
/** @var Escaper $escaper */

$config = $block->getData('cookie_config');
if (!$config instanceof Config || !$config->isEnabled()) {
    return;
}

$categories = $config->getCategories();
$privacyUrl = $config->getPrivacyUrl();
$linkLabel = $config->getLinkLabel();
$cssUrl = $block->getViewFileUrl('Slova_CookieConsent::css/consent.css');
$jsUrl = $block->getViewFileUrl('Slova_CookieConsent::js/consent.js');
?>
<link rel="stylesheet" href="<?= $escaper->escapeUrl($cssUrl) ?>">
<script src="<?= $escaper->escapeUrl($jsUrl) ?>" defer></script>
<div id="slova-cookie-consent"
     class="slova-cc"
     x-data="slovaCookieConsent"
     data-slova-cookie-consent="<?= $escaper->escapeHtmlAttr($config->getJsConfig()) ?>"
     @keydown.escape.window="closeModal"
>
    <section class="slova-cc-banner <?= $escaper->escapeHtmlAttr($config->getPositionClass()) ?>"
             x-cloak
             x-show="isBannerVisible"
             aria-labelledby="slova-cc-title"
    >
        <div class="slova-cc-banner__body">
            <p id="slova-cc-title" class="slova-cc-banner__title">
                <?= $escaper->escapeHtml($config->getTitle()) ?>
            </p>
            <p class="slova-cc-banner__text">
                <?= $escaper->escapeHtml($config->getMessage()) ?>
                <?php if ($privacyUrl !== ''): ?>
                    <a href="<?= $escaper->escapeUrl($privacyUrl) ?>" class="slova-cc-link">
                        <?= $escaper->escapeHtml($linkLabel) ?>
                    </a>
                <?php endif; ?>
            </p>
        </div>
        <div class="slova-cc-banner__actions">
            <?php /* Accept and Reject look the same: EU regulators expect equal weight. */ ?>
            <button type="button" class="slova-cc-btn" @click="rejectAll">
                <?= $escaper->escapeHtml(__('Reject all')) ?>
            </button>
            <button type="button" class="slova-cc-btn" @click="acceptAll">
                <?= $escaper->escapeHtml(__('Accept all')) ?>
            </button>
            <button type="button" class="slova-cc-text-btn" @click="openModal">
                <?= $escaper->escapeHtml(__('Customize')) ?>
            </button>
        </div>
    </section>

    <div class="slova-cc-overlay" x-cloak x-show="isModalVisible" @click.self="closeModal">
        <div class="slova-cc-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="slova-cc-modal-title"
             tabindex="-1"
             x-ref="dialog"
        >
            <button type="button"
                    class="slova-cc-close"
                    @click="closeModal"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>"
                    title="<?= $escaper->escapeHtmlAttr(__('Close')) ?>"
            >
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                >
                    <path d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>

            <h2 id="slova-cc-modal-title" class="slova-cc-modal__title">
                <?= $escaper->escapeHtml(__('Cookie preferences')) ?>
            </h2>
            <p class="slova-cc-modal__intro">
                <?= $escaper->escapeHtml(
                    __('Choose which cookies you allow. You can change your choice at any time.')
                ) ?>
                <?php if ($privacyUrl !== ''): ?>
                    <a href="<?= $escaper->escapeUrl($privacyUrl) ?>" class="slova-cc-link">
                        <?= $escaper->escapeHtml($linkLabel) ?>
                    </a>
                <?php endif; ?>
            </p>

            <?php foreach ($categories as $category): ?>
                <?php $id = 'slova-cc-category-' . $category['code']; ?>
                <div class="slova-cc-category">
                    <div class="slova-cc-category__head">
                        <label for="<?= $escaper->escapeHtmlAttr($id) ?>" class="slova-cc-category__label">
                            <?= $escaper->escapeHtml($category['label']) ?>
                        </label>
                        <?php if ($category['required']): ?>
                            <span class="slova-cc-category__always">
                                <?= $escaper->escapeHtml(__('Always on')) ?>
                            </span>
                        <?php endif; ?>
                        <span class="slova-cc-switch">
                            <input type="checkbox"
                                   role="switch"
                                   id="<?= $escaper->escapeHtmlAttr($id) ?>"
                                   data-category="<?= $escaper->escapeHtmlAttr($category['code']) ?>"
                                   aria-describedby="<?= $escaper->escapeHtmlAttr($id) ?>-description"
                                <?php if ($category['required']): ?>
                                   checked
                                   disabled
                                <?php else: ?>
                                   :checked="isChecked"
                                   @change="onToggle"
                                <?php endif; ?>
                            >
                            <span class="slova-cc-switch__track" aria-hidden="true"></span>
                        </span>
                    </div>
                    <p id="<?= $escaper->escapeHtmlAttr($id) ?>-description" class="slova-cc-category__description">
                        <?= $escaper->escapeHtml($category['description']) ?>
                    </p>
                </div>
            <?php endforeach; ?>

            <div class="slova-cc-modal__actions">
                <button type="button" class="slova-cc-btn slova-cc-btn--outline" @click="rejectAll">
                    <?= $escaper->escapeHtml(__('Reject all')) ?>
                </button>
                <button type="button" class="slova-cc-btn slova-cc-btn--outline" @click="acceptAll">
                    <?= $escaper->escapeHtml(__('Accept all')) ?>
                </button>
                <button type="button" class="slova-cc-btn" @click="savePreferences">
                    <?= $escaper->escapeHtml(__('Save preferences')) ?>
                </button>
            </div>
        </div>
    </div>

    <?php if ($config->showReopenButton()): ?>
        <button type="button"
                class="slova-cc-reopen"
                x-cloak
                x-show="isReopenVisible"
                @click="openModal"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Cookie settings')) ?>"
                title="<?= $escaper->escapeHtmlAttr(__('Cookie settings')) ?>"
        >
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
            >
                <path d="M12 3a9 9 0 1 0 9 9 3 3 0 0 1-3.5-3A3 3 0 0 1 14 5.5 3 3 0 0 1 12 3z"/>
                <circle cx="8.5" cy="10.5" r="1" fill="currentColor"/>
                <circle cx="12" cy="15.5" r="1" fill="currentColor"/>
                <circle cx="16" cy="13" r=".8" fill="currentColor"/>
                <circle cx="8" cy="15" r=".6" fill="currentColor"/>
            </svg>
        </button>
    <?php endif; ?>
</div>
